Options -Indexes
DirectoryIndex index.html
RewriteEngine On
RewriteBase /

# Preserve addresses used by the previous THIEL website.
RewriteRule ^ueber-uns\.html$ /about/ [R=301,L]
RewriteRule ^impressum\.html$ /impressum/ [R=301,L]
RewriteRule ^datenschutz\.html$ /datenschutz/ [R=301,L]
RewriteRule ^ankauf\.html$ /ankauf/ [R=301,L]
RewriteRule ^bestand\.html$ /bestand/ [R=301,L]
RewriteRule ^automobile\.html$ / [R=301,L]

# Keep the existing extensionless local routes on IONOS/Apache.
RewriteRule ^(about|kontakt|impressum|datenschutz|bestand|ankauf)/?$ /$1/index.html [L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(html|css|js|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
