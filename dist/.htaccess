Options -Indexes
DirectoryIndex index.html
RewriteEngine On

# Preserve addresses used by the previous THIEL website.
RewriteRule ^ueber-uns\.html$ /about [R=301,L]
RewriteRule ^impressum\.html$ /impressum [R=301,L]
RewriteRule ^datenschutz\.html$ /datenschutz [R=301,L]
RewriteRule ^ankauf\.html$ /kontakt [R=301,L]
RewriteRule ^(?:automobile|bestand)\.html$ / [R=301,L]

# Keep the existing extensionless local routes on IONOS/Apache.
RewriteRule ^(about|kontakt|impressum|datenschutz)/?$ $1/index.html [L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
