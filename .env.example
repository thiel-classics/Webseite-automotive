# Copy locally to .env. Never put secrets in dist/ or source control.
# For production, set these variables in the hosting environment.
NODE_ENV=development
PORT=4173

# Exact public origin, without trailing slash. Local preview:
PUBLIC_ORIGIN=http://127.0.0.1:4173
# Production requires an https:// origin and an HTTPS reverse proxy.
# Only enable when that proxy connects via loopback, strips client forwarding
# headers and sets X-Forwarded-Proto itself; otherwise leave empty.
TRUST_PROXY=

# Supply the actual SMTP provider settings. 465 usually uses SMTP_SECURE=true;
# 587 uses SMTP_SECURE=false with mandatory STARTTLS. TLS cannot be disabled.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Authenticated, provider-authorized sender address (not the visitor's address).
SMTP_FROM=

# Enable only after a reviewed local privacy page exists at
# dist/datenschutz/index.html (or dist/datenschutz.html).
PRIVACY_NOTICE_READY=false
